FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# System deps for psycopg2-binary are bundled, but keep CA certs for outbound HTTPS (Supabase/Sentry).
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt /app/backend/requirements.txt
RUN python -m pip install --upgrade pip && pip install -r /app/backend/requirements.txt

COPY backend /app/backend

EXPOSE 8000

# Render/Fly/etc will provide DATABASE_URL, SUPABASE_* envs, etc.
CMD ["python", "-m", "uvicorn", "backend.fastapi_app:app", "--host", "0.0.0.0", "--port", "8000"]
