ENVIRONMENT=production
REQUIRE_SUPABASE_AUTH=true
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET

# PRODUCTION MINIMUM (required)
# Backend environment variables (example)
# Copy to backend/.env and fill values.

# App
# Docs are disabled by default in production (override only if you explicitly want public docs).
ENABLE_DOCS=false
LOG_LEVEL=INFO
APP_VERSION=2.0.0

# Database (Supabase / Postgres)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Connection pooling (optional)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend-domain.com

# Security gate
SUPABASE_JWT_AUD=authenticated

# Optional extra hardening (shared API key)
REQUIRE_API_KEY=false
ESE_API_KEY=YOUR_BACKEND_API_KEY

# Break-glass (optional): force a specific email as super admin
# SUPER_ADMIN_EMAIL=ceo@yourdomain.com

# Bootstrap super admin (recommended): ensure a CEO row exists in `people`
# Used by: `python -m backend.bootstrap_ceo`
# BOOTSTRAP_CEO_EMAIL=ceo@yourdomain.com
# BOOTSTRAP_CEO_FULL_NAME=CEO Name
# BOOTSTRAP_CEO_FORCE=false

# Sentry (optional)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=
SENTRY_PROFILES_SAMPLE_RATE=
SENTRY_SEND_DEFAULT_PII=false
