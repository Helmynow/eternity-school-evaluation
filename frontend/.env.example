# Frontend environment variables (example)
# Copy to frontend/.env and fill values.

VITE_API_URL=http://localhost:8000

# Optional shared API key for backend additional hardening (must match backend ESE_API_KEY)
VITE_API_KEY=

# Supabase (required)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Optional monitoring
VITE_SENTRY_DSN=

