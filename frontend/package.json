{
  "name": "eternity-school-evaluation-frontend",
  "version": "1.0.0",
  "description": "Employee of the Month & Multi-Rater Evaluation System for Eternity School of Egypt",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/validateEnv.mjs",
    "build": "vite build",
    "vercel-build": "npm run build",
    "preview": "vite preview",
